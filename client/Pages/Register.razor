@page "/register"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IConfiguration Configuration

<div class="w-full max-w-md bg-white rounded-xl shadow-md border-t-4 border-green-500 p-8 text-center">
    <div class="mx-auto w-16 h-16 bg-green-50 text-green-500 rounded-full flex items-center justify-center mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
    </div>
    
    <h2 class="text-2xl font-bold text-gray-800 mb-2">Register</h2>
    <p class="text-gray-600 text-sm mb-8 leading-relaxed">
        Silakan isi formulir di bawah ini untuk membuat akun baru.
    </p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mb-4 p-2 bg-red-100 text-red-700 test-sm rounded">
            @errorMessage
        </div>
    }

    <EditForm Model="@form" OnValidSubmit="HandleRegister">
        <input type="text" @bind="form.Username" placeholder="Username" class="w-full mb-4 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring focus:border-green-500">
        <input type="password" @bind="form.Password" placeholder="Password" class="w-full mb-4 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring focus:border-green-500">
        <button type="submit" class="w-full py-2.5 bg-green-500 text-white text-sm font-semibold rounded-lg hover:bg-green-600 transition-colors cursor-pointer">
            Register
        </button>
    </EditForm>
</div>

@code
{
    private RegisterRequest form = new RegisterRequest();
    private string? errorMessage;

    public class RegisterRequest
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class ValidateErrorResponse
    {
        public Dictionary<string, string[]> Errors { get; set; } = new();
    }

    private async Task HandleRegister()
    {
        errorMessage = null;

        try
        {
            string apiBaseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5285/";
            Uri registerUrl = new Uri(new Uri(apiBaseUrl), "api/auth/register");
            HttpResponseMessage response = await Http.PostAsJsonAsync(registerUrl, form);

            if (response.IsSuccessStatusCode)
            {
                NavManager.NavigateTo("/login");
            }
            else
            {
                ValidateErrorResponse? validationResponse = await response.Content.ReadFromJsonAsync<ValidateErrorResponse>();
                
                if (validationResponse?.Errors != null && validationResponse.Errors.Any())
                {
                    if (validationResponse.Errors.ContainsKey("Username"))
                    {
                        errorMessage = validationResponse.Errors["Username"].FirstOrDefault();
                    }
                    else
                    {
                        errorMessage = validationResponse.Errors.First().Value.FirstOrDefault();
                    }
                }
                
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Can't connect to the server. Please try again later.";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}

